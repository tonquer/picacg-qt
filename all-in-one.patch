+def iso_to_tick(text):
+    """书库时间形如 2026-11-01T16:15:06.796Z。"""
+    if not text or not isinstance(text, str):
+        return None
+    for fmt in ("%Y-%m-%dT%H:%M:%S.%f%z", "%Y-%m-%dT%H:%M:%S%z"):
+        try:
